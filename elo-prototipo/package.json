{
  "name": "elo-prototipo-academico",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Protótipo acadêmico de financiamento coletivo, com dados fictícios e pagamentos simulados.",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node --env-file-if-exists=.env server/index.mjs",
    "start": "node server/index.mjs",
    "setup": "node scripts/setup-env.mjs",
    "dev:embedded": "node --env-file-if-exists=.env server/dev-embedded.mjs",
    "test": "node scripts/test.mjs",
    "test:postgres": "node --env-file-if-exists=.env scripts/test-postgres.mjs",
    "db:migrate": "node --env-file-if-exists=.env server/db/migrate.mjs",
    "check:compose": "node scripts/check-compose.mjs",
    "db:backup": "node scripts/backup.mjs"
  },
  "engines": {
    "node": ">=22.9.0"
  },
  "dependencies": {
    "pg": "8.23.1",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.17",
    "yaml": "2.9.1"
  }
}
